# Gmail SMTP for the "Parolni unutdingizmi?" codes (see README: "Parolni tiklash").
# MAIL_PASSWORD is a 16-character Google *App Password*, not the normal Gmail password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Error logs to Telegram: create a bot with @BotFather, add it to your channel/group as an admin,
# put its token and the chat id here, then set LOG_STACK=single,telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_LEVEL=error

# Hours between the activity summaries (logins, listings, errors) sent to Telegram
TELEGRAM_DIGEST_HOURS=3

# Public channel for approved listings (a different bot and channel from the log ones above)
TELEGRAM_CHANNEL_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
