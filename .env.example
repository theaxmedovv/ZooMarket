# Gmail SMTP for the "Parolni unutdingizmi?" codes (see README: "Parolni tiklash").
# MAIL_PASSWORD is a 16-character Google *App Password*, not the normal Gmail password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
